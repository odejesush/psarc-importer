<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\lib\Rocksmith2014.NET\src\Rocksmith2014.Audio\Rocksmith2014.Audio.fsproj" />
    <ProjectReference Include="..\..\lib\Rocksmith2014.NET\src\Rocksmith2014.DLCProject\Rocksmith2014.DLCProject.fsproj" />
    <ProjectReference Include="..\..\lib\Rocksmith2014.NET\src\Rocksmith2014.XML\Rocksmith2014.XML.csproj" />
    <ProjectReference Include="..\..\lib\Rocksmith2014.NET\src\Rocksmith2014.XML.Processing\Rocksmith2014.XML.Processing.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PsarcImporter.Tests" />
    <InternalsVisibleTo Include="PsarcImporter.Gui" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>

  <Target Name="CopyImporterManifest" AfterTargets="Publish">
    <Copy SourceFiles="importer.json" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
